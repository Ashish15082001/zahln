<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later read these rules, not allowBackup, when moving data to
  a new phone. Nothing goes: the saved login in the WebView's storage stays on
  the phone it was made on. The cloud backup is listed too, though
  allowBackup="false" already turns it off.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
